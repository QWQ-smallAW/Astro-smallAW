---
// 季节性飘落粒子：3-5 月樱花、11-1 月雪，其他月份默认关闭
// 开关：localStorage 'particles'（off 关闭）；终端命令 particles on|off 会同步写这里
// 尊重 prefers-reduced-motion；换页后自动在新 canvas 上重启
---

<canvas class="particles" id="particles" aria-hidden="true"></canvas>

<script>
  type Petal = {
    x: number;
    y: number;
    r: number;
    vy: number;
    sway: number;
    phase: number;
    rot: number;
    vr: number;
    alpha: number;
  };

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const MONTH = new Date().getMonth() + 1;
  const season: 'sakura' | 'snow' | null =
    MONTH >= 3 && MONTH <= 5 ? 'sakura' : MONTH === 11 || MONTH === 12 || MONTH === 1 ? 'snow' : null;

  let raf = 0;
  let running = false;
  let petals: Petal[] = [];

  const isOn = () => localStorage.getItem('particles') !== 'off';

  function spawn(c: HTMLCanvasElement, fromTop: boolean): Petal {
    const dark = document.documentElement.dataset.theme !== 'light';
    return {
      x: Math.random() * c.width,
      y: fromTop ? -20 : Math.random() * c.height,
      r: season === 'sakura' ? 3 + Math.random() * 4 : 1.2 + Math.random() * 2.2,
      vy: season === 'sakura' ? 0.5 + Math.random() * 0.9 : 0.6 + Math.random() * 1.1,
      sway: 0.4 + Math.random() * 0.9,
      phase: Math.random() * Math.PI * 2,
      rot: Math.random() * Math.PI * 2,
      vr: (Math.random() - 0.5) * 0.04,
      alpha: 0.5 + Math.random() * 0.4,
    };
  }

  function draw(ctx: CanvasRenderingContext2D, p: Petal) {
    ctx.save();
    ctx.translate(p.x, p.y);
    ctx.rotate(p.rot);
    ctx.globalAlpha = p.alpha;
    if (season === 'sakura') {
      ctx.fillStyle =
        document.documentElement.dataset.theme === 'light' ? '#eda9c4' : '#f4c0d1';
      ctx.beginPath();
      ctx.ellipse(0, 0, p.r, p.r * 0.55, 0, 0, Math.PI * 2);
      ctx.fill();
    } else {
      ctx.fillStyle = document.documentElement.dataset.theme === 'light' ? '#b9cfdd' : '#ffffff';
      ctx.beginPath();
      ctx.arc(0, 0, p.r, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
  }

  function loop(ctx: CanvasRenderingContext2D, c: HTMLCanvasElement) {
    ctx.clearRect(0, 0, c.width, c.height);
    for (const p of petals) {
      p.y += p.vy;
      p.phase += 0.012;
      p.x += Math.sin(p.phase) * p.sway * 0.4;
      p.rot += p.vr;
      if (p.y > c.height + 24) {
        Object.assign(p, spawn(c, true));
      }
      draw(ctx, p);
    }
    raf = requestAnimationFrame(() => loop(ctx, c));
  }

  function start() {
    if (running || reduced || !season || !isOn()) return;
    const c = document.getElementById('particles') as HTMLCanvasElement | null;
    if (!c) return;
    const ctx = c.getContext('2d');
    if (!ctx) return;
    resize(c);
    running = true;
    petals = Array.from({ length: 16 }, () => spawn(c, false));
    loop(ctx, c);
  }

  function stop() {
    running = false;
    cancelAnimationFrame(raf);
    const c = document.getElementById('particles') as HTMLCanvasElement | null;
    c?.getContext('2d')?.clearRect(0, 0, c.width, c.height);
  }

  function resize(c: HTMLCanvasElement) {
    c.width = window.innerWidth;
    c.height = window.innerHeight;
  }

  window.addEventListener('resize', () => {
    const c = document.getElementById('particles') as HTMLCanvasElement | null;
    if (c) resize(c);
  });

  // 终端 particles on|off 命令
  document.addEventListener('particles', (e) => {
    const detail = (e as CustomEvent).detail as { on?: boolean } | undefined;
    if (detail?.on === false) stop();
    else start();
  });

  // View Transitions 换页后 canvas 被替换 —— 重新启动
  document.addEventListener('astro:page-load', () => {
    stop();
    start();
  });

  start();
</script>
