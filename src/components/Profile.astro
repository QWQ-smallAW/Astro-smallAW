---
import '@fontsource/caveat/500.css';
import { SITE, SOCIALS } from '../site.config';
import { withBase } from '../utils';
---

<div class="profile">
  <span class="avatar-wrap">
    <img class="avatar" src={withBase('/avatar.jpg')} alt="作者头像" width="72" height="72" />
  </span>
  <h2 class="profile-name">{SITE.author}</h2>
  <p class="profile-sig">{SITE.signature}</p>
  <nav class="socials" aria-label="社交链接">
    {
      SOCIALS.map((s) => (
        <a href={s.url} target="_blank" rel="noopener" aria-label={s.name} title={s.name}>
          {s.name === 'GitHub' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            </svg>
          )}
          {s.name === 'Bilibili' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7.2 4.6 5.4 2.6" />
              <path d="M16.8 4.6 18.6 2.6" />
              <rect x="2.8" y="4.8" width="18.4" height="14.4" rx="4" />
              <path d="M8.4 10.2v3.4" />
              <path d="M15.6 10.2v3.4" />
              <path d="M9.8 16h4.4" />
            </svg>
          )}
          {s.name === '知乎' && (
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="2.5" y="2.5" width="19" height="19" rx="5" fill="none" stroke="currentColor" stroke-width="1.8" />
              <text x="12" y="12.6" text-anchor="middle" dominant-baseline="central" font-size="11.5" font-weight="600" fill="currentColor" font-family="-apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif">知</text>
            </svg>
          )}
          {s.name === 'QQ' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3.2c-5 0-9 3.3-9 7.5 0 2.4 1.3 4.6 3.3 6l-.7 3.5 3.8-2c.8.2 1.7.3 2.6.3 5 0 9-3.4 9-7.6S17 3.2 12 3.2z" />
              <circle cx="9" cy="10.4" r="0.4" fill="currentColor" />
              <circle cx="15" cy="10.4" r="0.4" fill="currentColor" />
            </svg>
          )}
        </a>
      ))
    }
  </nav>
</div>
