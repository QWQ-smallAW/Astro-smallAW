---
import BaseLayout from './BaseLayout.astro';
import SidebarToc from '../components/SidebarToc.astro';
import Comments from '../components/Comments.astro';
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime, withBase, tagSlug } from '../utils';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
  prev?: { slug: string; title: string };
  next?: { slug: string; title: string };
}

const { post, headings, prev, next } = Astro.props;
const { title, date, updated, tags, description } = post.data;

// 过时提示：以 updated（无则回退到发布日期）距构建时间超过 7 天为准
const lastMod = updated ?? date;
const STALE_MS = 7 * 24 * 60 * 60 * 1000;
const isStale = Date.now() - lastMod.getTime() > STALE_MS;
---

<BaseLayout title={title} description={description}>
  <Fragment slot="sidebar">
    <SidebarToc headings={headings} />
  </Fragment>
  <article>
    <header class="article-header">
      <p class="prompt-line">
        <span class="user">you@blog</span><span class="punct">:~$</span>
        <span class="cmd">cat posts/{post.id}.md</span>
      </p>
      <h1>{title}</h1>
      <div class="article-meta">
        <span class="date">{formatDate(date)}</span>
        {updated && updated.getTime() !== date.getTime() && (
          <><span>·</span><span class="date">更新于 {formatDate(updated)}</span></>
        )}
        <span>·</span>
        <span>{readingTime(post.body ?? '')}</span>
        {tags.length > 0 && <span>·</span>}
      </div>
      {tags.length > 0 && (
        <div class="tag-row">
          {tags.map((t) => (
            <a class="tag" href={withBase(`/tags/${tagSlug(t)}/`)}>{t}</a>
          ))}
        </div>
      )}
    </header>

    {isStale && (
      <div class="stale-notice" role="note">
        <span class="mark">[!]</span> 本文最后更新于 {formatDate(lastMod)}，距今已超过 7
        天，内容可能已经过时，请酌情参考。
      </div>
    )}

    <div class="article-body">
      <div class="prose">
        <slot />
      </div>
    </div>

    <nav class="post-nav" aria-label="文章导航">
      <div>
        {prev && (
          <a href={withBase(`/posts/${prev.slug}/`)}>
            <span class="label">&lt;- prev</span>
            {prev.title}
          </a>
        )}
      </div>
      <div style="text-align: right;">
        {next && (
          <a href={withBase(`/posts/${next.slug}/`)}>
            <span class="label">next -&gt;</span>
            {next.title}
          </a>
        )}
      </div>
    </nav>

    <Comments />

    <p class="back-home">
      <a href={withBase('/')}>$ cd ~</a>
    </p>
  </article>
</BaseLayout>
